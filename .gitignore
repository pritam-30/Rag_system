# Secrets — non-negotiable, especially after that key was shared earlier
.env

# Python bytecode — matches __pycache__ at every depth (top-level, knowlegdeBase/, operations/)
__pycache__/
*.pyc

# Virtual environment — large, platform-specific, fully reproducible from requirements.txt
rag_env/
.venv/

# Vector database — regenerate via buildDB.py, don't version binary DB files
chroma_db/

# DeepEval local cache + run artifacts
.deepeval/
.deepeval-cache.json
.latest_run_full.json
.latest_test_run.json
.temp-deepeval-cache.json
.temp_test_run_data.json

# Local debugging / helper scripts
debug_DB.py

# Editor settings — personal, not project config
.vscode/

# OS junk
.DS_Store
Thumbs.db

temporary.py
app.py
export_chunks.py
all_chunks.json
# Large PDFs and datasets - keep data separate
data/
*.pdf

# Optional: lock files
requirements.txt.lock